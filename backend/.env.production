# =====================================================
# CONFIGURACIÓN DE PRODUCCIÓN - AZURE
# =====================================================
# ⚠️ NO SUBIR ESTE ARCHIVO A GITHUB
# ⚠️ Las variables reales se configurarán en Azure Portal

# Configuración del servidor
PORT=3001
NODE_ENV=production
HOST=0.0.0.0

# Configuración de la base de datos PostgreSQL (Azure)
# ⚠️ ACTUALIZAR después de crear el servidor PostgreSQL en Azure
DB_HOST=TU_SERVIDOR_POSTGRES.postgres.database.azure.com
DB_PORT=5432
DB_NAME=sistema_ventas_multiempresa
DB_USER=azureuser
DB_PASSWORD=TU_CONTRASEÑA_SEGURA

# Configuración de JWT
# ⚠️ GENERAR una clave secreta segura (usa: openssl rand -base64 32)
JWT_SECRET=GENERA_UNA_CLAVE_SECRETA_MUY_SEGURA_AQUI
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Configuración de email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=eventconnect90@gmail.com
EMAIL_PASSWORD=oshzkgssiwxfdiqr
EMAIL_FROM=Sistema de Ventas <eventconnect90@gmail.com>

# Configuración de CORS
# ⚠️ ACTUALIZAR después de crear el Static Web App en Azure
CORS_ORIGIN=https://TU_STATIC_WEB_APP.azurestaticapps.net
FRONTEND_URL=https://TU_STATIC_WEB_APP.azurestaticapps.net

# Configuración de bcrypt
BCRYPT_SALT_ROUNDS=10

