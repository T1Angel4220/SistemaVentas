pipeline {
    agent any
    
    environment {
        // URL del repositorio GitHub
        GITHUB_REPO_URL = 'https://github.com/T1Angel4220/SistemaVentas.git'
        GITHUB_BRANCH = 'Jenkins/Johan'
        DOCKER_IMAGE_BACKEND = 'sistema-ventas-backend'
        DOCKER_IMAGE_FRONTEND = 'sistema-ventas-frontend'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
        DOCKER_REGISTRY = 'docker.io' // Cambiar si usas un registro privado
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'Clonando repositorio desde GitHub...'
                echo '========================================'
                script {
                    // Clonar el repositorio
                    sh '''
                        if [ -d "SistemaVentas" ]; then
                            echo "El directorio ya existe, eliminando..."
                            rm -rf SistemaVentas
                        fi
                        
                        echo "Clonando repositorio desde GitHub..."
                        echo "URL: ${GITHUB_REPO_URL}"
                        git clone ${GITHUB_REPO_URL} || {
                            echo "ERROR: No se pudo clonar el repositorio"
                            echo "Por favor, verifica la URL del repositorio en el Jenkinsfile"
                            echo "URL configurada: ${GITHUB_REPO_URL}"
                            exit 1
                        }
                        
                        cd SistemaVentas
                        
                        echo "Cambiando a la rama ${GITHUB_BRANCH}..."
                        git checkout ${GITHUB_BRANCH} || {
                            echo "La rama ${GITHUB_BRANCH} no existe localmente, intentando desde origin..."
                            git fetch origin
                            git checkout -b ${GITHUB_BRANCH} origin/${GITHUB_BRANCH} || {
                                echo "ERROR: No se pudo cambiar a la rama ${GITHUB_BRANCH}"
                                echo "Verifica que la rama existe en el repositorio remoto"
                                exit 1
                            }
                        }
                        
                        echo "Haciendo pull de la rama ${GITHUB_BRANCH}..."
                        git pull origin ${GITHUB_BRANCH} || {
                            echo "ADVERTENCIA: No se pudo hacer pull, continuando con el código local"
                        }
                        
                        echo "Información del repositorio:"
                        git log -1 --oneline
                        git branch -a
                        echo "Rama actual:"
                        git branch --show-current
                    '''
                }
            }
        }
        
        stage('Build Backend') {
            steps {
                echo '========================================'
                echo 'Construyendo imagen Docker del backend...'
                echo '========================================'
                script {
                    sh '''
                        cd SistemaVentas
                        docker build -t ${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG} -f DesarrolloAPE/Dockerfile.backend .
                        docker tag ${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG} ${DOCKER_IMAGE_BACKEND}:latest
                        echo "Imagen backend construida: ${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG}"
                    '''
                }
            }
        }
        
        stage('Build Frontend') {
            steps {
                echo '========================================'
                echo 'Construyendo imagen Docker del frontend...'
                echo '========================================'
                script {
                    sh '''
                        cd SistemaVentas
                        docker build -t ${DOCKER_IMAGE_FRONTEND}:${DOCKER_TAG} -f DesarrolloAPE/Dockerfile.frontend .
                        docker tag ${DOCKER_IMAGE_FRONTEND}:${DOCKER_TAG} ${DOCKER_IMAGE_FRONTEND}:latest
                        echo "Imagen frontend construida: ${DOCKER_IMAGE_FRONTEND}:${DOCKER_TAG}"
                    '''
                }
            }
        }
        
        stage('Test') {
            steps {
                echo '========================================'
                echo 'Ejecutando pruebas...'
                echo '========================================'
                script {
                    // Ejecutar pruebas dentro de contenedor (opcional)
                    try {
                        sh '''
                            cd SistemaVentas
                            docker run --rm \
                                -v ${WORKSPACE}/SistemaVentas/backend:/app \
                                -w /app \
                                node:18-alpine \
                                npm test || echo "Tests no configurados o fallaron"
                        '''
                    } catch (Exception e) {
                        echo "Tests no ejecutados o fallaron: ${e.getMessage()}"
                        // No fallar el pipeline si las pruebas fallan (ajustar según necesidad)
                    }
                }
            }
        }
        
        stage('Stop Old Containers') {
            steps {
                echo '========================================'
                echo 'Deteniendo contenedores antiguos...'
                echo '========================================'
                script {
                    sh '''
                        cd SistemaVentas/DesarrolloAPE
                        # Detener solo los servicios de la aplicación (sin Jenkins)
                        # Usamos stop en lugar de down para no eliminar volúmenes
                        docker-compose stop backend frontend postgres || true
                        # Eliminar contenedores detenidos de la aplicación
                        docker rm -f sistema-ventas-backend sistema-ventas-frontend sistema-ventas-db 2>/dev/null || true
                        # Limpiar contenedores huérfanos (excluyendo Jenkins)
                        docker container prune -f || true
                    '''
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo '========================================'
                echo 'Desplegando aplicación...'
                echo '========================================'
                script {
                    sh '''
                        cd SistemaVentas/DesarrolloAPE
                        # Levantar solo los servicios de la aplicación (sin Jenkins)
                        docker-compose up -d --build backend frontend postgres
                        # Esperar a que los servicios estén listos
                        sleep 15
                        # Verificar estado de los contenedores de la aplicación
                        docker-compose ps backend frontend postgres
                    '''
                }
            }
        }
        
        stage('Health Check') {
            steps {
                echo '========================================'
                echo 'Verificando salud de la aplicación...'
                echo '========================================'
                script {
                    sh '''
                        cd SistemaVentas/DesarrolloAPE
                        
                        # Esperar un poco más para que los servicios estén completamente listos
                        echo "Esperando a que los servicios estén listos..."
                        sleep 20
                        
                        # Verificar estado de los contenedores
                        echo "Verificando estado de los contenedores..."
                        docker-compose ps backend frontend postgres
                        
                        # Verificar que los contenedores estén corriendo
                        echo ""
                        echo "Verificando estado de los contenedores..."
                        
                        BACKEND_RUNNING=$(docker ps --filter "name=sistema-ventas-backend" --filter "status=running" --format "{{.Names}}" | grep -q sistema-ventas-backend && echo "yes" || echo "no")
                        FRONTEND_RUNNING=$(docker ps --filter "name=sistema-ventas-frontend" --filter "status=running" --format "{{.Names}}" | grep -q sistema-ventas-frontend && echo "yes" || echo "no")
                        DB_RUNNING=$(docker ps --filter "name=sistema-ventas-db" --filter "status=running" --format "{{.Names}}" | grep -q sistema-ventas-db && echo "yes" || echo "no")
                        
                        # Verificar backend
                        if [ "$BACKEND_RUNNING" = "yes" ]; then
                            echo "✅ Backend está corriendo"
                            echo "Verificando respuesta del backend..."
                            docker exec sistema-ventas-backend wget -q --spider --timeout=5 http://localhost:3001/health 2>/dev/null && \
                                echo "✅ Backend responde en /health" || \
                                (docker exec sistema-ventas-backend wget -q --spider --timeout=5 http://localhost:3001/ 2>/dev/null && \
                                 echo "✅ Backend responde en /" || \
                                 echo "⚠️ Backend no responde HTTP, pero el contenedor está corriendo")
                        else
                            echo "❌ Backend no está corriendo"
                            exit 1
                        fi
                        
                        # Verificar frontend
                        if [ "$FRONTEND_RUNNING" = "yes" ]; then
                            echo "✅ Frontend está corriendo"
                            echo "Verificando respuesta del frontend..."
                            docker exec sistema-ventas-frontend wget -q --spider --timeout=5 http://localhost/ 2>/dev/null && \
                                echo "✅ Frontend responde" || \
                                echo "⚠️ Frontend no responde HTTP, pero el contenedor está corriendo"
                        else
                            echo "❌ Frontend no está corriendo"
                            exit 1
                        fi
                        
                        # Verificar base de datos
                        if [ "$DB_RUNNING" = "yes" ]; then
                            echo "✅ Base de datos está corriendo"
                        else
                            echo "❌ Base de datos no está corriendo"
                            exit 1
                        fi
                        
                        echo ""
                        echo "=========================================="
                        echo "✅ Health check completado exitosamente"
                        echo "=========================================="
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo '========================================'
            echo 'Pipeline ejecutado exitosamente!'
            echo '========================================'
            echo "Build Number: ${env.BUILD_NUMBER}"
            echo "Backend Image: ${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG}"
            echo "Frontend Image: ${DOCKER_IMAGE_FRONTEND}:${DOCKER_TAG}"
            // Opcional: Enviar notificación por email
            // emailext (
            //     subject: "Pipeline Exitoso: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
            //     body: "El pipeline se ejecutó correctamente.",
            //     to: "tu-email@ejemplo.com"
            // )
        }
        failure {
            echo '========================================'
            echo 'Pipeline falló!'
            echo '========================================'
            echo "Build Number: ${env.BUILD_NUMBER}"
            // Opcional: Enviar notificación de error
            // emailext (
            //     subject: "Pipeline Falló: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
            //     body: "El pipeline falló. Revisar logs.",
            //     to: "tu-email@ejemplo.com"
            // )
        }
        always {
            echo '========================================'
            echo 'Limpiando imágenes antiguas...'
            echo '========================================'
            script {
                sh '''
                    # Eliminar imágenes huérfanas (sin tag)
                    docker image prune -f || true
                    
                    # Opcional: Eliminar imágenes antiguas (mantener últimas 5)
                    # docker images --format "{{.Repository}}:{{.Tag}}" | \
                    #   grep -E "${DOCKER_IMAGE_BACKEND}|${DOCKER_IMAGE_FRONTEND}" | \
                    #   tail -n +6 | xargs -r docker rmi || true
                '''
            }
            // Archivar artefactos si es necesario
            archiveArtifacts artifacts: 'SistemaVentas/DesarrolloAPE/docker-compose.yml', allowEmptyArchive: true
        }
    }
}

